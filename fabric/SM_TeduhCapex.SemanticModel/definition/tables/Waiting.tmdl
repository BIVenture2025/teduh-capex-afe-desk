/// Requests waiting for a decision and how long.
table Waiting
	lineageTag: fd45d6f8-617e-538e-ab03-46d2b8dd808f

	/// Requests in Submitted, Finance check or LOA approval now.
	measure 'Waiting for a decision' = COALESCE ( COUNTROWS ( Waiting ), 0 )
		formatString: #,0
		displayFolder: Approvals
		lineageTag: 5083c9f1-ac7d-5557-9cd4-f60c4aa7dfac

	/// Days since the request reached its current step.
	measure 'Days waiting' = MAX ( Waiting[days_waiting] )
		formatString: 0
		displayFolder: Approvals
		lineageTag: 8a388823-cb1f-5e7d-9ac6-ca335d7da09c

