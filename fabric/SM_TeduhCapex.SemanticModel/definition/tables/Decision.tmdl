/// One row per approval step of every request (originals and supplements).
table Decision
	lineageTag: d8285288-03d7-589d-99c5-13d8e49b3d19

	/// Requests (originals and supplements) with a decision step.
	measure Requests = COALESCE ( DISTINCTCOUNT ( Decision[afe_no] ), 0 )
		formatString: #,0
		displayFolder: Approvals
		lineageTag: cf3c73d2-576a-53b3-971d-f27c829f2657

	/// Days in the finance check per request; a returned request counts its finance days twice.
	measure 'Finance days per request' = DIVIDE ( CALCULATE ( SUM ( Decision[days] ), Decision[step] = "Finance check" ), CALCULATE ( DISTINCTCOUNT ( Decision[afe_no] ), Decision[step] = "Finance check" ) )
		formatString: 0.0
		displayFolder: Approvals
		lineageTag: 05872a93-6c16-549d-a5d5-c4feaf340523

	/// Days at the LOA approver per request.
	measure 'LOA days per request' = DIVIDE ( CALCULATE ( SUM ( Decision[days] ), Decision[step] = "LOA approval" ), CALCULATE ( DISTINCTCOUNT ( Decision[afe_no] ), Decision[step] = "LOA approval" ) )
		formatString: 0.0
		displayFolder: Approvals
		lineageTag: 4b67a485-b565-5c23-ae0e-9fe6ab216786

	/// Mean days from first submit to the LOA decision, decided requests.
	measure 'Submit to decision' =
			VAR r = FILTER ( VALUES ( Decision[afe_no] ), CALCULATE ( COUNTROWS ( Decision ), Decision[step] = "LOA approval" ) > 0 )
			RETURN
				AVERAGEX ( r, CALCULATE ( DATEDIFF ( MIN ( Decision[submitted_on] ), MAX ( Decision[decided_on] ), DAY ) ) )
		formatString: 0.0
		displayFolder: Approvals
		lineageTag: 02571399-a47d-5a51-9e86-865d41b187df

	/// Median of the same.
	measure 'Median submit to decision' =
			VAR r = FILTER ( VALUES ( Decision[afe_no] ), CALCULATE ( COUNTROWS ( Decision ), Decision[step] = "LOA approval" ) > 0 )
			RETURN
				MEDIANX ( r, CALCULATE ( DATEDIFF ( MIN ( Decision[submitted_on] ), MAX ( Decision[decided_on] ), DAY ) ) )
		formatString: 0
		displayFolder: Approvals
		lineageTag: a7d03c8d-7d5b-5fe0-a4b4-bd70f852b5fb

	/// Steps where finance returned the request.
	measure Returned = COALESCE ( CALCULATE ( COUNTROWS ( Decision ), Decision[outcome] = "Returned" ), 0 )
		formatString: #,0
		displayFolder: Approvals
		lineageTag: 39c3ee67-a84c-5916-a507-2af6817e1c48

	/// Requests rejected at the LOA step.
	measure Rejected = COALESCE ( CALCULATE ( COUNTROWS ( Decision ), Decision[outcome] = "Rejected" ), 0 )
		formatString: #,0
		displayFolder: Approvals
		lineageTag: 49e83b55-891d-5943-bd0e-07122b8ee624

	/// Approvals title.
	measure 'Title approvals' =
			VAR t3 = CALCULATE ( [Submit to decision], Decision[request_tier] = "T3" )
			VAR t1 = CALCULATE ( [Submit to decision], Decision[request_tier] = "T1" )
			RETURN
				"CEO-tier requests take " & FORMAT ( t3, "0.0" ) & " days from submit to decision, against " & FORMAT ( t1, "0.0" ) & " at T1"
		displayFolder: Titles
		lineageTag: bd4b174c-75b0-51a8-97a9-261f5e67de23

