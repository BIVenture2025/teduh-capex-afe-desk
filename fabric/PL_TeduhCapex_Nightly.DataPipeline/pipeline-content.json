{
  "properties": {
    "description": "P38 nightly: Dataverse to lake, ERP extract, Gold, Gold to Dataverse; a verdict gate after each step.",
    "activities": [
      {
        "name": "RunCopyIn",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "38a00000-0000-4000-8000-0000000000a3",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "parameters": {
            "copy_job": {
              "value": "CJ_AFE_In",
              "type": "string"
            }
          }
        }
      },
      {
        "name": "GateCopyIn",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "RunCopyIn",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "type": "Expression",
            "value": "@and(not(equals(pipeline().parameters.p_block_at, 'CopyIn')), endswith(string(json(activity('RunCopyIn').output.result.exitValue).verdict), '_OK'))"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "name": "FailCopyIn",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": {
                  "type": "Expression",
                  "value": "@concat('CopyIn blocked: ', substring(string(activity('RunCopyIn').output.result.exitValue), 0, min(400, length(string(activity('RunCopyIn').output.result.exitValue)))))"
                },
                "errorCode": "P38_COPYIN_BLOCKED"
              }
            }
          ]
        }
      },
      {
        "name": "RunERP",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "GateCopyIn",
