  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Words used in this report",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#1B2A3A",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "AFE: authority for expenditure, the approval to spend capital on one project, with its estimate by cost element.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2A3A"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Supplement: a supplementary AFE that raises the approved amount of an original AFE. It adds approval, not estimate.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2A3A"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "LOA: limits of authority. Finance checks every AFE first; then the asset manager (up to RM 5m), GM Projects (up to RM 25m) or the CEO, on the AFE total including supplements.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2A3A"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Committed: actual cost booked plus purchase orders not yet invoiced.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2A3A"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "EAC: estimate at completion: committed cost plus the remaining estimate, scaled by how awards are running against estimate. Contingency is not counted.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2A3A"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Headroom: approved minus committed. A supplement is flagged when EAC passes 110% of approval.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2A3A"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "WP&B: work programme and budget, the asset's approved annual capex budget.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2A3A"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
