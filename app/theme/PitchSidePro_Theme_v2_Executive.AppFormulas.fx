// BREAKPOINTS: 640 / 1024 are the powerappsui catalog standard (not the ScreenSize enum's 600/900).
nfIsMobile  = App.Width < 640;
nfIsDesktop = App.Width >= 1024;
nfPageMaxW  = 1200;

// Chart series, in the Power BI theme's dataColors order (same colour, same meaning, report and app).
nfChart = Table({ Key: "Chart1", Color: nfColor.Chart1 }, { Key: "Chart2", Color: nfColor.Chart2 }, { Key: "Chart3", Color: nfColor.Chart3 }, { Key: "Chart4", Color: nfColor.Chart4 }, { Key: "Chart5", Color: nfColor.Chart5 }, { Key: "Chart6", Color: nfColor.Chart6 }, { Key: "Chart7", Color: nfColor.Chart7 }, { Key: "Chart8", Color: nfColor.Chart8 }, { Key: "Chart9", Color: nfColor.Chart9 }, { Key: "Chart10", Color: nfColor.Chart10 });
