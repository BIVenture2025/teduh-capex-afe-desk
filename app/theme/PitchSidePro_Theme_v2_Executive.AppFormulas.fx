// THE SWITCH. Off by default; to let users choose, replace false with e.g.
// Coalesce(First(colUserPrefs).ThemeName, "Light") = "Dark"  (DocRouter pattern; needs colUserPrefs)
nfIsDark = false;
nfColor  = If(nfIsDark, nfColorDark, nfColorLight);

nfHex(c: Color): Text = Mid(JSON(c), 2, 7);      // "#rrggbb" for HTML/SVG strings
nfHexA(c: Color): Text = Mid(JSON(c), 2, 9);     // "#rrggbbaa"

nfFont = "'Segoe UI', 'Segoe UI', sans-serif";

// TYPE SCALE in PIXELS (modern controls). Classic controls size in POINTS: never carry a value across unconverted.
nfType = {
    PageTitle:   28,
    SectionHead: 20,
